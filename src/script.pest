// PEG grammar for BSV bitcoin script, as accepted by the debugger.
//
// Two rules govern every opcode alternation below:
//
//  1. PEG ordered choice is committed: the first alternative that matches wins
//     and the parser never comes back to try a later one. So every opcode that
//     is a prefix of another opcode MUST be listed after the longer one, or the
//     longer one becomes unreachable (e.g. `OP_NOP` before `OP_NOP1` makes
//     `OP_NOP1` parse as `OP_NOP` followed by the integer `1`).
//  2. `word_end` is asserted after every opcode and integer so that a partial
//     match cannot silently succeed. With ordering alone, a new opcode added in
//     the wrong place mis-parses silently; with `word_end` it fails loudly.

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT    = _{ ("/*" ~ (!"*/" ~ ANY)* ~ "*/") | ("//" ~ (!NEWLINE ~ ANY)*) }

// An opcode or integer token must not be followed by another identifier
// character, otherwise it is only a prefix of a longer word.
word_end = _{ !(ASCII_ALPHANUMERIC | "_") }

// Opcodes whose mnemonics contain a digit. Kept separate only because the
// original grammar did; ordering across the three groups is what matters.
long_opcode = @{
      ^"OP_1ADD" | ^"OP_1SUB" | ^"OP_2MUL" | ^"OP_2DIV" | ^"OP_2DROP" | ^"OP_2DUP" | ^"OP_3DUP"
    | ^"OP_2OVER" | ^"OP_2ROT" | ^"OP_2SWAP" | ^"OP_IFDUP"
    | ^"OP_NUMEQUALVERIFY" | ^"OP_0NOTEQUAL" | ^"OP_NUMEQUAL" | ^"OP_NUMNOTEQUAL"
}

verify_opcodes = @{ ^"OP_CHECKMULTISIGVERIFY" | ^"OP_CHECKSIGVERIFY" | ^"OP_VERIFY" }

short_opcode = @{
    // Constants. OP_10..OP_16 precede OP_1, and OP_1NEGATE precedes OP_1.
      ^"OP_1NEGATE" | ^"OP_0" | ^"OP_10" | ^"OP_11" | ^"OP_12" | ^"OP_13" | ^"OP_14" | ^"OP_15" | ^"OP_16"
    | ^"OP_1" | ^"OP_2" | ^"OP_3" | ^"OP_4" | ^"OP_5" | ^"OP_6" | ^"OP_7" | ^"OP_8" | ^"OP_9"
    // Push operations.
    | ^"OP_PUSHDATA1" | ^"OP_PUSHDATA2" | ^"OP_PUSHDATA4"
    // Flow control. OP_IF/OP_NOTIF/OP_ELSE/OP_ENDIF are handled by if_statement.
    // OP_VERNOTIF and OP_VERIF must precede OP_VER.
    //
    // OP_NOP10 precedes OP_NOP1, which is a prefix of it, and OP_NOP9 precedes
    // OP_NOP for the same reason.
    //
    // OP_NOP4..OP_NOP8 are deliberately absent. Genesis reclaimed those slots
    // in BSV, so they are aliases rather than no-ops -- src/script/opcodes.h
    // has OP_NOP4 = OP_SUBSTR (0xb3), OP_NOP5 = OP_LEFT, OP_NOP6 = OP_RIGHT,
    // OP_NOP7 = OP_LSHIFTNUM, OP_NOP8 = OP_RSHIFTNUM. Every one of those is
    // already accepted here under the name it actually does something as.
    // Accepting the OP_NOPn spelling too would mean a script printed back
    // under a different mnemonic than it was written in, which is its own
    // confusion; adding them is a decision, not an omission.
    | ^"OP_NOP10" | ^"OP_NOP1" | ^"OP_NOP9" | ^"OP_NOP"
    | ^"OP_VERNOTIF" | ^"OP_VERIF" | ^"OP_VER" | ^"OP_RETURN"
    // Stack.
    | ^"OP_TOALTSTACK" | ^"OP_FROMALTSTACK" | ^"OP_DEPTH" | ^"OP_DROP"
    | ^"OP_DUP" | ^"OP_NIP" | ^"OP_OVER" | ^"OP_PICK" | ^"OP_ROLL" | ^"OP_ROT" | ^"OP_SWAP" | ^"OP_TUCK"
    // Splice.
    | ^"OP_CAT" | ^"OP_SPLIT" | ^"OP_SUBSTR" | ^"OP_LEFT" | ^"OP_RIGHT"
    | ^"OP_NUM2BIN" | ^"OP_BIN2NUM" | ^"OP_SIZE"
    // Bitwise logic. OP_EQUALVERIFY precedes OP_EQUAL; OP_RESERVED1/2 precede OP_RESERVED.
    | ^"OP_INVERT" | ^"OP_AND" | ^"OP_OR" | ^"OP_XOR" | ^"OP_EQUALVERIFY" | ^"OP_EQUAL"
    | ^"OP_RESERVED1" | ^"OP_RESERVED2" | ^"OP_RESERVED"
    // Arithmetic. OP_LSHIFTNUM/OP_RSHIFTNUM precede OP_LSHIFT/OP_RSHIFT, and the
    // ...OREQUAL comparisons precede their shorter forms.
    | ^"OP_NEGATE" | ^"OP_ABS" | ^"OP_NOT" | ^"OP_ADD" | ^"OP_SUB" | ^"OP_MUL" | ^"OP_DIV" | ^"OP_MOD"
    | ^"OP_LSHIFTNUM" | ^"OP_RSHIFTNUM" | ^"OP_LSHIFT" | ^"OP_RSHIFT"
    | ^"OP_BOOLAND" | ^"OP_BOOLOR"
    | ^"OP_LESSTHANOREQUAL" | ^"OP_LESSTHAN" | ^"OP_GREATERTHANOREQUAL" | ^"OP_GREATERTHAN"
    | ^"OP_MIN" | ^"OP_MAX" | ^"OP_WITHIN"
    // Crypto. OP_CHECKMULTISIG precedes OP_CHECKSIG only for readability; they
    // do not share a prefix.
    | ^"OP_RIPEMD160" | ^"OP_SHA1" | ^"OP_SHA256" | ^"OP_HASH160" | ^"OP_HASH256"
    | ^"OP_CODESEPARATOR" | ^"OP_CHECKMULTISIG" | ^"OP_CHECKSIG"
    // Locktime.
    | ^"OP_CHECKLOCKTIMEVERIFY" | ^"OP_CHECKSEQUENCEVERIFY"
}

opcode = @{ (long_opcode | verify_opcodes | short_opcode) ~ word_end }

// Hex literals are whole bytes: an odd digit count is a typo, not a half byte.
hex_data = @{ "0x" ~ (ASCII_HEX_DIGIT{2})+ ~ word_end }

// A decimal script number, optionally negative.
integer = @{ "-"? ~ ASCII_DIGIT+ ~ word_end }

data = @{ hex_data | integer }

statement = { opcode | data | if_statement }

if_token    = @{ (^"OP_NOTIF" | ^"OP_IF") ~ word_end }
else_token  = @{ ^"OP_ELSE" ~ word_end }
endif_token = @{ ^"OP_ENDIF" ~ word_end }

// Branches may be empty (`OP_IF OP_ENDIF` is valid script), and bitcoin permits
// more than one OP_ELSE in a single conditional.
if_statement = { if_token ~ statement* ~ (else_token ~ statement*)* ~ endif_token }

script = { SOI ~ statement* ~ EOI }
